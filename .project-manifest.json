{
  "schema_version": 1,
  "name": "solo-0033-media-workbench",
  "project_name": "solo-0033-media-workbench",
  "project_shape": "backend",
  "modules": [
    {
      "id": "assets",
      "path": "mediaworkbench/assets.py",
      "responsibility": "媒体探测与内容指纹"
    },
    {
      "id": "db",
      "path": "mediaworkbench/db.py",
      "responsibility": "SQLite兼容表结构和短写事务"
    },
    {
      "id": "timeline",
      "path": "mediaworkbench/timeline.py",
      "responsibility": "有序编辑、乐观修订与短读快照"
    },
    {
      "id": "planner",
      "path": "mediaworkbench/planner.py",
      "responsibility": "不可变逐次剪辑计划和缓存身份"
    },
    {
      "id": "encoder",
      "path": "mediaworkbench/encoder.py",
      "responsibility": "逐段归一化和有序拼接"
    },
    {
      "id": "jobs",
      "path": "mediaworkbench/jobs.py",
      "responsibility": "持久化租约、代次和检查点状态机"
    },
    {
      "id": "segment_cache",
      "path": "mediaworkbench/segment_cache.py",
      "responsibility": "跨进程互斥、片段字节及校验清单"
    },
    {
      "id": "worker",
      "path": "mediaworkbench/worker.py",
      "responsibility": "中断恢复、租约续期和分段执行"
    },
    {
      "id": "publication",
      "path": "mediaworkbench/publication.py",
      "responsibility": "文件归属与数据库完成状态协调"
    },
    {
      "id": "renders",
      "path": "mediaworkbench/renders.py",
      "responsibility": "同步与持久化导出公共服务"
    },
    {
      "id": "server",
      "path": "mediaworkbench/server.py",
      "responsibility": "JSON HTTP接口和连接寿命"
    },
    {
      "id": "tools",
      "path": "mediaworkbench/tools.py",
      "responsibility": "有界子进程及取消检查"
    },
    {
      "id": "audio_signal",
      "path": "mediaworkbench/audio_signal.py",
      "responsibility": "逐次裁切音频解码与增益后双声道活动检测"
    },
    {
      "id": "audio_layers",
      "path": "mediaworkbench/audio_layers.py",
      "responsibility": "有修订的配音实例与一致混音快照"
    },
    {
      "id": "ducking",
      "path": "mediaworkbench/ducking.py",
      "responsibility": "重叠配音攻击释放曲线的下包络及交点"
    },
    {
      "id": "mix_plan",
      "path": "mediaworkbench/mix_plan.py",
      "responsibility": "冻结活动区间和试听曲线并校验持久化摘要"
    },
    {
      "id": "mix_render",
      "path": "mediaworkbench/mix_render.py",
      "responsibility": "磁盘暂存、定长块混音和整节目统一峰值补偿"
    },
    {
      "id": "media_sources",
      "path": "mediaworkbench/media_sources.py",
      "responsibility": "不可变素材身份与原片/代理位置分离、用途选择"
    },
    {
      "id": "proxies",
      "path": "mediaworkbench/proxies.py",
      "responsibility": "非阻塞代理准备、请求代次发布与离线预览"
    },
    {
      "id": "relinking",
      "path": "mediaworkbench/relinking.py",
      "responsibility": "批量原片内容核验与短事务修订回连"
    },
    {
      "id": "transition_plan",
      "path": "mediaworkbench/transition_plan.py",
      "responsibility": "毫秒精度重叠排布、单次末尾量化与不可变方案"
    },
    {
      "id": "transition_signal",
      "path": "mediaworkbench/transition_signal.py",
      "responsibility": "多路覆盖归一化、线性光像素和逐采样声音"
    },
    {
      "id": "transition_render",
      "path": "mediaworkbench/transition_render.py",
      "responsibility": "一次物化和有界逐帧合成及受保护发布"
    }
  ],
  "workflows": [
    {
      "id": "timeline-edit",
      "name": "素材登记与原子时间线编辑",
      "entry": "POST /projects/{id}/timeline",
      "steps": [
        "探测素材并保存哈希",
        "校验逐次裁切及预期修订",
        "短事务原子替换和读取新修订"
      ],
      "success": "返回新修订的完整有序时间线",
      "failure": "非法片段或陈旧修订整批拒绝",
      "verification": "python3 -m mediaworkbench.check --workflow timeline",
      "module_ids": [
        "server",
        "assets",
        "tools",
        "timeline",
        "db"
      ]
    },
    {
      "id": "media-render",
      "name": "冻结并导出规范化成片",
      "entry": "POST /renders",
      "steps": [
        "冻结一致时间线并校验素材",
        "逐次规划及校验或编码片段",
        "有序拼接并保护目标文件发布"
      ],
      "success": "返回完成MP4及冻结修订",
      "failure": "记录失败，保留可核对的已发布产物意图，不删除公共目标路径",
      "verification": "python3 -m mediaworkbench.check --workflow render",
      "module_ids": [
        "server",
        "renders",
        "timeline",
        "planner",
        "jobs",
        "worker",
        "segment_cache",
        "encoder",
        "publication",
        "db",
        "tools"
      ]
    },
    {
      "id": "resumable-render",
      "name": "持久化分段任务接管和取消",
      "entry": "POST /render-jobs/{id}/run",
      "steps": [
        "接管排队或租约过期任务并增加代次",
        "续期并复验检查点及损坏缓存",
        "记录组装产物意图并发布或取消"
      ],
      "success": "原冻结计划恢复并完成，旧工作进程被隔离",
      "failure": "租约丢失停止子进程；取消终止任务；其他失败可显式重试",
      "verification": "python3 -m mediaworkbench.check --workflow recovery",
      "module_ids": [
        "server",
        "renders",
        "jobs",
        "worker",
        "planner",
        "segment_cache",
        "encoder",
        "publication",
        "db",
        "tools"
      ]
    },
    {
      "id": "voice-ducking",
      "name": "配音避让试听与有界内存整节目混音",
      "entry": "POST /mix-plans; POST /mix-plans/{id}/render",
      "steps": [
        "以编辑修订冻结背景和配音实例",
        "逐次裁切分析实际可听活动并生成连续避让曲线",
        "保存不可变方案",
        "每实例解码一次并在临时磁盘保存PCM",
        "定长块扫描整节目峰值后统一补偿导出WAV"
      ],
      "success": "背景仅在可听配音处平顺避让，重叠不重复压低，整节目保持相对响度并在192MiB环境导出",
      "failure": "变动源文件、越界配音和目标冲突拒绝；失败释放暂存文件",
      "verification": "python3 -m mediaworkbench.check --workflow mix",
      "module_ids": [
        "server",
        "db",
        "assets",
        "timeline",
        "audio_layers",
        "audio_signal",
        "ducking",
        "mix_plan",
        "mix_render"
      ]
    },
    {
      "id": "offline-relink",
      "name": "离线代理预览与原片批量回连",
      "entry": "POST /assets/{id}/proxy; POST /asset-relinks; POST /projects/{id}/preview",
      "steps": [
        "保留可用代理并分配新请求代次",
        "在事务外准备及校验不可变代理文件",
        "将当前代次代理发布供离线预览",
        "批量校验原片身份并按位置修订原子回连",
        "已冻结任务按原身份解析新的原片位置"
      ],
      "success": "原片离线仍可预览，交付只用相同内容的原片；旧请求不覆盖新代理或已接受回连",
      "failure": "错误原片、陈旧回连整批拒绝；失败刷新保留旧代理；准备失败清理私有文件",
      "verification": "python3 -m mediaworkbench.check --workflow sources",
      "module_ids": [
        "media_sources",
        "proxies",
        "relinking",
        "assets",
        "db",
        "timeline",
        "planner",
        "jobs",
        "worker",
        "server"
      ]
    },
    {
      "id": "overlap-transitions",
      "name": "多路重叠转场音画一致合成",
      "entry": "POST /transition-plans; POST /transition-plans/{id}/render",
      "steps": [
        "冻结裁切、增益和邻接重叠",
        "建立单一采样时钟并只对末尾视频量化",
        "解码每个镜头实例到私有磁盘",
        "按多路同时覆盖合成线性光画面和原增益声音",
        "逐帧及块写出并保护发布目标"
      ],
      "success": "短中间镜头的三路转场保留正确亮度和声音，短镜头序列不累计帧量化漂移且内存固定",
      "failure": "非法重叠不保存、变动原片拒绝、失败清理临时数据、旧方案不随新编辑变化",
      "verification": "python3 -m mediaworkbench.check --workflow transitions",
      "module_ids": [
        "transition_plan",
        "transition_signal",
        "transition_render",
        "media_sources",
        "timeline",
        "planner",
        "db",
        "server"
      ]
    }
  ],
  "complexity": {
    "mechanisms": [
      "optimistic_revision",
      "concurrency",
      "immutable_plan",
      "content_addressed_media",
      "checkpoint_revalidation",
      "lease_fencing",
      "resource_lifecycle",
      "error_propagation",
      "recoverable_publication",
      "waveform_activity",
      "piecewise_lower_envelope",
      "bounded_pcm_streaming",
      "global_peak_compensation",
      "immutable_mix_plan",
      "logical_asset_relocation",
      "rendition_trust_separation",
      "generation_publication",
      "optimistic_batch_relink",
      "simultaneous_transition_coverage",
      "linear_light_compositing",
      "exact_av_clock",
      "bounded_frame_compositing"
    ]
  }
}
